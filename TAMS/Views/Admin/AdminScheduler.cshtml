@using TAMS.Models

@{
    var appointments = ViewBag.Appointments as List<Appointment> ?? new List<Appointment>();
    var schedules = ViewBag.Schedules as List<Schedule> ?? new List<Schedule>();
    var tutors = ViewBag.Tutors as List<Tutor> ?? new List<Tutor>();

    int month = ViewBag.Month;
    int year = ViewBag.Year;
    var now = DateTime.Now;

    var firstDay = new DateTime(year, month, 1);
    int daysInMonth = DateTime.DaysInMonth(year, month);
    int startDayOfWeek = (int)firstDay.DayOfWeek;
    int day = 1;

    int totalCells = daysInMonth + startDayOfWeek;
    int weeks = (int)Math.Ceiling(totalCells / 7.0);

    int prevMonth = month - 1;
    int prevYear = year;
    if (prevMonth < 1) { prevMonth = 12; prevYear--;}

    int nextMonth = month + 1;
    int nextYear = year;
    if (nextMonth > 12) { nextMonth = 1; nextYear++; }
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminScheduler.css" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" />
}

<body>
    <div class="admin-scheduler">
        <header class="admin-scheduler-header">
            <div class="admin-scheduler-heading">
                <span class="admin-scheduler-eyebrow"> BMB &#8901; ADMIN PORTAL </span>
                <h1>Appointment Scheduler</h1>
                <p> Manage tutor availability and review appointment time slots. </p>
            </div>

            <div class="admin-scheduler-header-actions">
                <a class="admin-scheduler-button admin-scheduler-button-secondary" asp-controller="Admin" asp-action="Dashboard">
                    &larr; Back to Dashboard
                </a>
            </div>
        </header>

        <section class="admin-scheduler-card">
            @if (TempData["AdminSchedulerError"] != null)
            {
                <div class="admin-scheduler-message admin-scheduler-message-error"
                     role="alert">
                    <strong>Schedule Conflict</strong>
                    <p>@TempData["AdminSchedulerError"]</p>
                </div>
            }

            @if (TempData["AdminSchedulerSuccess"] != null)
            {
                <div class="admin-scheduler-message admin-scheduler-message-success"
                     role="status">
                    @TempData["AdminSchedulerSuccess"]
                </div>
            }
            <div class="admin-scheduler-toolbar">
                <a class="admin-scheduler-button admin-scheduler-button-secondary month-nav-button"
                   asp-controller="Admin" asp-action="Scheduler" asp-route-month="@prevMonth" asp-route-year="@prevYear">
                    &larr; Previous Month
                </a>

                <div class="admin-scheduler-current-month">
                    <span class="admin-scheduler-month-label"> SCHEDULE OVERVIEW </span>
                    <h2>@firstDay.ToString("MMMM yyyy")</h2>
                </div>

                <a class="admin-scheduler-button admin-scheduler-button-secondary month-nav-button"
                   asp-controller="Admin" asp-action="Scheduler" asp-route-month="@nextMonth" asp-route-year="@nextYear">
                    Next Month &rarr;
                </a>
            </div>

            <div class="admin-scheduler-legend">
                <span class="status-indicator status-available"></span>
                <span>Available</span>

                <span class="status-indicator status-booked"></span>
                <span>Booked</span>

                <span class="status-indicator status-completed"></span>
                <span>Completed</span>

                <span class="status-indicator status-expired"></span>
                <span>Expired</span>
            </div>

            <div class="admin-scheduler-table-wrapper">
                <table class="admin-scheduler-table">
                    <thead>
                        <tr>
                            @foreach (var weekday in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                            {
                                <th>@weekday</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int week = 0; week < weeks; week++)
                        {
                            <tr>
                                @for (int dow = 0; dow < 7; dow++)
                                {
                                    if ((week == 0 && dow < startDayOfWeek) || day > daysInMonth)
                                    {
                                        <td class="admin-scheduler-empty-cell"></td>
                                    }
                                    else
                                    {
                                        var currentDate = new DateTime(year, month, day);
                                        var dayAppointments = appointments.Where(a => a.AppointmentDate.Date == currentDate.Date).OrderBy(a => a.AppointmentDate.TimeOfDay).ToList();
                                        // var daySchedules = schedules.Where(s => s.Date.Date == currentDate.Date).OrderBy(s => s.StartTime).ToList();
                                        var daySchedules = schedules
                                        .Where(s => s.Date.Date == currentDate.Date)
                                        .Where(s =>
                                        {
                                            var slotDateTime = s.Date.Date.Add(s.StartTime);

                                            // Keep future slots and slots associated with booked/completed appointments.
                                            var slotAppointments = appointments
                                                            .Where(a => a.ScheduleId == s.ScheduleId)
                                                            .ToList();

                                            bool isCompleted = slotAppointments.Any(a =>
                                                            a.Status?.Trim().Equals("Completed",
                                                            StringComparison.OrdinalIgnoreCase) == true);

                                            bool isBooked = slotAppointments.Any(a =>
                                                            a.Status?.Trim().Equals("Scheduled",
                                                            StringComparison.OrdinalIgnoreCase) == true);

                                            return slotDateTime >= now || isCompleted || isBooked;
                                        })
                                        .OrderBy(s => s.StartTime)
                                        .ToList();

                                        <td class="admin-scheduler-day-cell">
                                            <div class="admin-scheduler-day-heading">
                                                <span class="admin-scheduler-day-number"> @day </span>
                                                <span class="admin-scheduler-day-name"> @currentDate.ToString("ddd") </span>
                                            </div>

                                            <div class="admin-scheduler-slots">
                                                @if (daySchedules.Any())
                                                {
                                                    @foreach (var slot in daySchedules)
                                                    {
                                                        var slotDateTime = slot.Date.Date.Add(slot.StartTime);
                                                        var slotAppointments = dayAppointments.Where(a => a.ScheduleId == slot.ScheduleId).ToList();
                                                        var slotCompleted = slotAppointments.Any(a => a.Status?.Trim().Equals("Completed", StringComparison.OrdinalIgnoreCase) == true);
                                                        var slotBooked = slotAppointments.Any(a => a.Status?.Trim().Equals("Scheduled", StringComparison.OrdinalIgnoreCase) == true);
                                                        //var slotExpired = !slotCompleted && !slotBooked && slotDateTime < now;
                                                        var tutorName = slot.Tutor != null ? $"{slot.Tutor.FName} {slot.Tutor.LName}" : "Tutor unavailable";
                                                                        

                                                        if (slotCompleted)
                                                        {
                                                            <div class="admin-slot admin-slot-completed">
                                                                <strong class="admin-slot-time">
                                                                    @DateTime.Today.Add(slot.StartTime).ToString("h:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("h:mm tt")
                                                                </strong>
                                                                <span class="admin-slot-status"> Completed </span>
                                                                <span class="admin-slot-tutor"> @tutorName </span>
                                                            </div>
                                                        }
                                                        else if (slotBooked)
                                                        {
                                                            <div class="admin-slot admin-slot-booked">
                                                                <strong class="admin-slot-time">
                                                                    @DateTime.Today.Add(slot.StartTime).ToString("h:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("h:mm tt")
                                                                </strong>
                                                                <span class="admin-slot-status"> Booked </span>
                                                                <span class="admin-slot-tutor"> @tutorName </span>
                                                            </div>
                                                        }
                                                        // else if (slotExpired)
                                                        // {
                                                        //     <div class="admin-slot admin-slot-expired">
                                                        //         <strong class="admin-slot-time">
                                                        //             @DateTime.Today.Add(slot.StartTime).ToString("h:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("h:mm tt")
                                                        //         </strong>
                                                        //         <span class="admin-slot-status"> Expired </span>
                                                        //         <span class="admin-slot-tutor"> @tutorName </span>
                                                        //     </div>
                                                        // }
                                                        else
                                                        {
                                                            <div class="admin-slot admin-slot-available">
                                                                <strong class="admin-slot-time">
                                                                    @DateTime.Today.Add(slot.StartTime).ToString("h:mm tt") - @DateTime.Today.Add(slot.EndTime).ToString("h:mm tt")
                                                                </strong>
                                                                <span class="admin-slot-status"> Available </span>
                                                                <span class="admin-slot-tutor"> @tutorName </span>
                                                            </div>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="admin-scheduler-no-slots"> No time slots </p>
                                                }
                                            </div>


                                            @if (currentDate.Date < DateTime.Today)
                                            {
                                                <p class="admin-scheduler-no-slots"> Past date — slots cannot be added. </p>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin" asp-action="AddSlot" method="post" class="admin-scheduler-add-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="date" value="@currentDate.ToString("yyyy-MM-dd")" />
                                                    <label class="admin-scheduler-label">Tutor</label>
                                                    <select name="tutorId" class="admin-scheduler-input" required>
                                                        <option value="">Select Tutor</option>

                                                        @foreach (var tutor in tutors)
                                                        {
                                                            <option value="@tutor.TutorId">
                                                                @tutor.FName @tutor.LName
                                                            </option>
                                                        }
                                                    </select>
                                                    <label class="admin-scheduler-label">Start time</label>
                                                    <input type="time" name="startTime" class="admin-scheduler-input" min="@(currentDate.Date == DateTime.Today ? DateTime.Now.ToString("HH:mm") : null)" required />
                                                    <label class="admin-scheduler-label">End time</label>
                                                    <input type="time" name="endTime" class="admin-scheduler-input" required />
                                                    <button type="submit" class="admin-scheduler-add-button"> &#43; Add Slot </button>
                                                </form>
                                            }

                                        </td>

                                        day++;
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="admin-scheduler-footer">
                Managing tutor availability for
                <strong>@firstDay.ToString("MMMM yyyy")</strong>
            </footer>

        </section>
    </div>
</body>