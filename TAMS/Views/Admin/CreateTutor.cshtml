@model TAMS.Models.TutorRegistration

@{
    ViewData["Title"] = "Create Tutor Account";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Create Tutor Account</h2>

                    <form asp-controller="Admin" asp-action="CreateTutor" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FName" class="form-label">First Name</label>
                                <input asp-for="FName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3"><label asp-for="LName" class="form-label">Last Name</label>
                                <input asp-for="LName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3"><label asp-for="Subject" class="form-label">Subject</label>
                            <input asp-for="Subject" class="form-control" placeholder="Enter tutoring subject" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <div class="mb-3"><label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="PhoneNumber"class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"class="form-label">Email</label>
                            <input asp-for="Email" type="email"class="form-control" placeholder="Enter email address" />
                            <span asp-validation-for="Email"class="text-danger"></span>
                        </div>

                        <hr />

                        <h5 class="mb-3">Tutor Login Information</h5>

                        <div class="mb-3">
                            <label asp-for="Username"class="form-label">Username</label>
                            <input asp-for="Username" class="form-control" placeholder="Create a username" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"> Confirm Password </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit"class="btn btn-primary">Create Tutor Account</button>
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}