@model TAMS.Models.Login

@{
    ViewData["Title"] = "Login";
}
@section Styles {
    <link href="~/css/Login.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
}

<body>
    <div class="login-wrapper">

        <div class="login-container">
            <div class="login-panel">
                <div class="brand-name"> BookMy<span>Brain</span> </div>
                <h1 class="login-heading"> Welcome back! </h1>
                <p class="login-subtitle"> Please sign in before continuing. </p>

                <form asp-controller="Login" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"> </div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"> Username </label>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"> </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password"  type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Login As</label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select">
                            <option value="">Please Select Your Role</option>
                        </select>
                        <span asp-validation-for="Role"class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn login-button">Sign In</button>
                    </div>

                    <a asp-controller="Login" asp-action="ForgotPassword" class="forgot-link">Forgot Password?</a>
                    <div class="login-divider"> Create an account </div>
                    <a asp-controller="Student" asp-action="StudentRegistration" class="register-button">Create Student Account</a>
                    <p class="signup-text">Don't have an account? <a asp-controller="Student" asp-action="StudentRegistration" class="signup-link">Sign Up Now</a> </p>
                </form>
            </div>

            <div class="illustration-panel">
                <div class="illustration-content">
                    <img src="~/images/BMB Owl.png" alt="BookMyBrain Owl" class="book-illustration" />
                </div>
            </div>
        </div>
    </div>
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
