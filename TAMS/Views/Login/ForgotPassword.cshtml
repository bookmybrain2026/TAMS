@model TAMS.Models.ForgotPassword

@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link href="~/css/ForgotPassword.css" rel="stylesheet" />
}

<div class="forgot-password-wrapper">
    <div class="forgot-password-container">
        <div class="forgot-password-panel">

            <!-- BookMyBrain Branding -->
            <div class="forgot-password-brand">
                BookMy<span>Brain</span>
            </div>

            <h1 class="forgot-password-heading">
                Forgot Password?
            </h1>

            <p class="forgot-password-subtitle">
                Enter your username and email address to recover your password.
            </p>

            <!-- Error Messages -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger forgot-password-alert">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        foreach (var error in modelState.Errors)
                        {
                            <p class="mb-1">@error.ErrorMessage</p>
                        }
                    }
                </div>
            }

            <!-- Email Error -->
            @if (TempData["EmailError"] != null)
            {
                <div class="alert alert-warning forgot-password-alert">
                    @TempData["EmailError"]
                </div>
            }

            <!-- Success Message -->
            @if (TempData["EmailSuccess"] != null)
            {
                <div class="alert alert-success forgot-password-alert">
                    @TempData["EmailSuccess"]
                </div>
            }

            <!-- Recovery Code Fallback -->
            @if (ViewBag.RecoveryCode != null)
            {
                <div class="alert alert-warning forgot-password-alert">
                    <strong>Email could not be sent.</strong>

                    <p class="mb-1 mt-2">
                        Your recovery code is:
                    </p>

                    <div class="forgot-password-recovery-code">
                        @ViewBag.RecoveryCode
                    </div>

                    <p class="mb-0 mt-2">
                        Please enter this code below to continue resetting your password.
                    </p>
                </div>
            }

            <!-- STEP 1: Verify Username and Email -->
            @if (!Model.ShowRecoveryCodeField && !Model.CodeVerified)
            {
                <form asp-controller="Login"
                      asp-action="VerifyUser"
                      method="post">

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">
                            Username
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Enter your username"
                               autocomplete="username" />

                        <span asp-validation-for="Username"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="forgot-password-actions d-grid">
                        <button type="submit"
                                class="btn forgot-password-primary">
                            Send Recovery Code
                        </button>
                    </div>

                    @* <div class="forgot-password-back">
                        <a asp-controller="Login"
                           asp-action="Login"
                           class="forgot-password-secondary">
                            Back to Login
                        </a>
                    </div> *@

                </form>
            }

            <!-- STEP 2: Verify Recovery Code -->
            @if (Model.ShowRecoveryCodeField && !Model.CodeVerified)
            {
                <hr class="forgot-password-divider" />

                <h2 class="forgot-password-section-heading">
                    Enter Recovery Code
                </h2>

                <p class="forgot-password-section-description">
                    Enter the recovery code that was sent to your email.
                </p>

                <form asp-controller="Login"
                      asp-action="VerifyRecoveryCode"
                      method="post">

                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="RecoveryCode" class="form-label">
                            Recovery Code
                        </label>

                        <input asp-for="RecoveryCode"
                               maxlength="6"
                               class="form-control forgot-password-code-input"
                               id="RecoveryCode"
                               placeholder="Enter 6-digit code"
                               inputmode="numeric"
                               autocomplete="one-time-code" />

                        <span asp-validation-for="RecoveryCode"
                              class="text-danger"></span>
                    </div>

                    <div class="forgot-password-actions d-grid">
                        <button type="submit"
                                class="btn forgot-password-primary">
                            Verify Recovery Code
                        </button>
                    </div>

                </form>
            }

            <!-- STEP 3: Reset Password -->
            @if (Model.ShowPasswordFields && Model.CodeVerified)
            {
                <hr class="forgot-password-divider" />

                <h2 class="forgot-password-section-heading">
                    Create a New Password
                </h2>

                <p class="forgot-password-section-description">
                    Enter and confirm your new password below.
                </p>

                <form asp-controller="Login"
                      asp-action="ResetPassword"
                      method="post">

                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="RecoveryCode" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">
                            New Password
                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control"
                               id="NewPassword"
                               placeholder="Enter your new password"
                               autocomplete="new-password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirm New Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               id="ConfirmPassword"
                               placeholder="Confirm your new password"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="forgot-password-actions d-grid">
                        <button type="submit"
                                class="btn forgot-password-primary">
                            Reset Password
                        </button>
                    </div>

                </form>
            }

            <!-- Footer -->
            <div class="forgot-password-footer">
                Remember your password?
                <a asp-controller="Login"
                   asp-action="Login"
                   class="forgot-password-login-link">
                    Log In
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassword() {
            var passField = document.getElementById("NewPassword");

            if (passField) {
                passField.type =
                    passField.type === "password"
                        ? "text"
                        : "password";
            }
        }
    </script>
}