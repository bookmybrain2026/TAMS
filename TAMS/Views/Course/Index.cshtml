@model IEnumerable<TAMS.Models.Course>
@using TAMS.Models

@{
    ViewData["Title"] = "Manage Courses";
    var subjects = ViewBag.Subjects as List<Subject>;
}

<a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary mb-3">← Back to Dashboard</a>

<h1>Manage Courses</h1>

<div class="mb-3">
    <button type="button" class="btn btn-primary" onclick="showCourseAddForm()">
        + Add New Course
    </button>
</div>

<div class="mb-3">
    <label for="courseSearch" class="form-label">Search Courses</label>
    <input type="text" id="courseSearch" class="form-control" placeholder="Search by subject, course code, or course name..." onkeyup="searchCourses()" />
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered" id="courseTable">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="courseTableBody">

        @foreach (var course in Model)
        {
            <tr>
                <td>
                    @course.SubjectCode

                    @if (subjects != null)
                    {
                        var subject = subjects.FirstOrDefault(
                        s => s.Code == course.SubjectCode);

                        if (subject != null)
                        {
                            <span> - @subject.Name</span>
                        }
                    }
                </td>
                <td>@course.CourseCode</td>
                <td>@course.CourseName</td>
                <td>
                    <button type="button" class="btn btn-warning" onclick="showCourseEditForm('@course.CourseId', '@course.SubjectCode', '@course.CourseCode', '@course.CourseName')">
                        Edit
                    </button>
                    <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this course?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@course.CourseId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<!-- ADD COURSE -->
<div id="addCourseModal" class="course-modal" style="display:none;">
    <div class="course-modal-content">
        <button type="button" class="course-modal-close" onclick="hideCourseForms()" aria-label="Close">
            &times;
        </button>
        <h3>Add New Course</h3>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group mb-3">
                <label for="CreateSubjectCode">Subject</label>

                <select id="CreateSubjectCode" name="SubjectCode" class="form-control" required>
                    <option value="">-- Select a Subject --</option>
                    @if (subjects != null)
                    {
                        foreach (var subject in subjects)
                        {
                            <option value="@subject.Code">
                                @subject.Code - @subject.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="CreateCourseCode">Course Code</label>
                <input type="text" id="CreateCourseCode" name="CourseCode" class="form-control" placeholder="Example: MATH 1314" required />
            </div>

            <div class="form-group mb-3">
                <label for="CreateCourseName">Course Name</label>
                <input type="text" id="CreateCourseName" name="CourseName" class="form-control" placeholder="Example: College Algebra" required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Create Course
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        onclick="hideCourseForms()">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>


<!-- EDIT COURSE -->
<div id="editCourseModal" class="course-modal" style="display:none;">
    <div class="course-modal-content">
        <button type="button"class="course-modal-close" onclick="hideCourseForms()" aria-label="Close">
            &times;
        </button>
        <h3>Edit Course</h3>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="EditCourseId" name="id" />
            <div class="form-group mb-3">
                <label for="EditSubjectCode">Subject</label>
                <select id="EditSubjectCode" name="SubjectCode" class="form-control" required>
                    <option value="">-- Select a Subject --</option>
                    @if (subjects != null)
                    {
                        foreach (var subject in subjects)
                        {
                            <option value="@subject.Code">
                                @subject.Code - @subject.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="EditCourseCode">Course Code</label>
                <input type="text" id="EditCourseCode" name="CourseCode" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="EditCourseName">Course Name</label>
                <input type="text" id="EditCourseName" name="CourseName" class="form-control" required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <button type="button" class="btn btn-secondary" onclick="hideCourseForms()">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

