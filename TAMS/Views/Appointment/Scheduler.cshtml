@using TAMS.Models
@using System.Linq

@{
    ViewData["Title"] = "Appointment Scheduler";

    var tutor = (Tutor)ViewBag.Tutor;
    var appointments = ViewBag.Appointments as List<Appointment> ?? new List<Appointment>();
    var schedules = ViewBag.Schedules as List<Schedule> ?? new List<Schedule>();

    int studentId = ViewBag.StudentId;
    int month = ViewBag.Month;
    int year = ViewBag.Year;

    var now = DateTime.Now;
    var firstDay = new DateTime(year, month, 1);
    var previousMonth = firstDay.AddMonths(-1);
    var nextMonth = firstDay.AddMonths(1);

    int daysInMonth = DateTime.DaysInMonth(year, month);
    int startDayOfWeek = (int)firstDay.DayOfWeek;

    var weekdays = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    var allTutors = ViewBag.Tutors as List<Tutor>
    ?? new List<Tutor>();

    int? rescheduleAppointmentId =
        ViewBag.RescheduleAppointmentId as int?;

    bool isRescheduling = rescheduleAppointmentId.HasValue;

    
var groupAppointments = ViewBag.GroupAppointments
    as List<TAMS.Models.GroupAppointment>
    ?? new List<TAMS.Models.GroupAppointment>();

}

@section Styles {
    <!--<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />-->
    <link rel="stylesheet" href="~/css/TutorScheduleCalendar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Scheduler.css" asp-append-version="true" />
}

<div class="student-schedule-calendar tutor-booking-page">

    <header class="scheduler-page-header">
        <div class="scheduler-heading">
            <p class="scheduler-eyebrow">BMB • STUDENT PORTAL</p>
            <h1>Appointment Scheduler</h1>
            <p class="scheduler-subtitle">
                View available tutoring times and book an appointment with
                <strong>@tutor.FName @tutor.LName</strong>.
            </p>
        </div>

        <div class="scheduler-header-actions">

            <a class="btn btn-secondary scheduler-back-button" href="@Url.Action("Dashboard", "Student", new { id = Context.Session.GetInt32("StudentId") })">
                &larr; Back to Dashboard
            </a>
        </div>
    </header>
    
    @if (isRescheduling)
    {
        <section class="scheduler-reschedule-card">
            <div class="scheduler-reschedule-heading">
                <div class="scheduler-reschedule-icon" aria-hidden="true">
                    &#8635;
                </div>

                <div>
                    <p class="scheduler-section-kicker">APPOINTMENT OPTIONS</p>
                    <h2>Reschedule Appointment</h2>
                    <p class="scheduler-reschedule-description">Keep your current tutor or choose another tutor. Select a tutor below to view their available time slots.</p>
                </div>
            </div>

            <form asp-controller="Appointment" asp-action="Scheduler" method="get" class="scheduler-reschedule-form">
                <input type="hidden" name="studentId" value="@studentId" />
                <input type="hidden" name="rescheduleAppointmentId" value="@rescheduleAppointmentId" />

                <div class="scheduler-reschedule-field">
                    <label for="tutorId">Choose your tutor</label>
                    <select id="tutorId" name="tutorId" class="scheduler-tutor-select" required>
                        @foreach (var item in allTutors)
                        {
                            <option value="@item.TutorId"
                                    selected="@(item.TutorId == tutor.TutorId)">
                                @item.FName @item.LName - @item.Subject
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="scheduler-reschedule-submit">
                    View Calendar
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </form>
        </section>
    }

    @if (TempData["AppointmentError"] != null)
    {
        <div class="scheduler-alert scheduler-alert-error" role="alert">
            <strong>Unable to complete booking</strong>
            <span>@TempData["AppointmentError"]</span>
        </div>
    }

    @if (TempData["AppointmentSuccess"] != null)
    {
        <div class="scheduler-alert scheduler-alert-success" role="status">
            <strong>Success</strong>
            <span>@TempData["AppointmentSuccess"]</span>
        </div>
    }

    <section class="scheduler-calendar-card">

        <div class="scheduler-calendar-heading">
            <div>
                <p class="scheduler-section-kicker">TUTOR AVAILABILITY</p>
                <h2>@firstDay.ToString("MMMM yyyy")</h2>
                <p class="scheduler-calendar-description">
                    Select an available time to book your tutoring appointment.
                </p>
            </div>
        </div>

        <div class="scheduler-calendar-toolbar">
            <a class="scheduler-month-button" href="@Url.Action("Scheduler", "Appointment", new {tutorId = tutor.TutorId, month = previousMonth.Month, year = previousMonth.Year, 
                studentId = studentId, rescheduleAppointmentId = rescheduleAppointmentId})">
                <span aria-hidden="true">←</span> Previous Month
            </a>

            <span class="scheduler-current-month">
                @firstDay.ToString("MMMM yyyy")
            </span>

            <a class="scheduler-month-button"
               href="@Url.Action("Scheduler", "Appointment", new { tutorId = tutor.TutorId, month = nextMonth.Month, year = nextMonth.Year, 
                   studentId = studentId, rescheduleAppointmentId = rescheduleAppointmentId})">
                Next Month <span aria-hidden="true">→</span> 
            </a>
        </div>

        <div class="scheduler-legend">
            <span class="scheduler-legend-item">
                <span class="scheduler-legend-dot available-dot"></span>
                Available
            </span>
            <span class="scheduler-legend-item">
                <span class="scheduler-legend-dot booked-dot"></span>
                Booked
            </span>
            <span class="scheduler-legend-item">
                <span class="scheduler-legend-dot completed-dot"></span>
                Completed
            </span>
            <span class="scheduler-legend-item">
                <span class="scheduler-legend-dot expired-dot"></span>
                Expired
            </span>

            <span class="scheduler-legend-item">
                <span class="scheduler-legend-dot group-dot"></span>
                Group Appointment
            </span>
        </div>

        <div class="scheduler-calendar-scroll">
            <table class="table scheduler-calendar-table">
                <thead>
                    <tr>
                        @foreach (var weekday in weekdays)
                        {
                            <th scope="col">@weekday</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @{
                        int currentDay = 1;
                    }

                    @while (currentDay <= daysInMonth)
                    {
                        <tr>
                            @for (int dow = 0; dow < 7; dow++)
                            {
                                if ((currentDay == 1 && dow < startDayOfWeek) ||
                                    currentDay > daysInMonth)
                                {
                                    <td class="scheduler-empty-cell"></td>
                                }
                                else
                                {
                                    var selectedDay = currentDay;
                                    var selectedDate = firstDay.AddDays(selectedDay - 1);
                                    var daySchedules = schedules.Where(s => s.Date.Date == selectedDate.Date).OrderBy(s => s.StartTime).ToList();
                                    var dayAppointments = appointments
                                        .Where(a => a.AppointmentDate.AddHours(-5).Date == selectedDate.Date && (a.Status == "Scheduled" || a.Status == "Completed"))
                                        .OrderBy(a => a.AppointmentDate.AddHours(-5).TimeOfDay).ToList();
                                    var isToday = selectedDate.Date == now.Date;

                                    <td class="scheduler-day-cell">
                                        <div class="scheduler-day-card">

                                            <div class="scheduler-day-heading">
                                                <span class="scheduler-day-number @(isToday ? "is-today" : "")">
                                                    @selectedDay
                                                </span>
                                                <span class="scheduler-day-name">
                                                    @selectedDate.ToString("ddd")
                                                </span>
                                            </div>

                                            <div class="scheduler-day-slots">
                                                @if (!daySchedules.Any())
                                                {
                                                    <p class="scheduler-no-slots"> No schedule </p>
                                                }
                                                else
                                                {
                                                    
                                                    @foreach (var s in daySchedules)
                                                    {
                                                        var slotDateTime = s.Date.Date.Add(s.StartTime);
                                                        var slotLabel = $"{DateTime.Today.Add(s.StartTime).ToString("h:mm tt")} - {DateTime.Today.Add(s.EndTime).ToString("h:mm tt")}";
                                                        var slotAppointments = appointments.Where(a => a.ScheduleId == s.ScheduleId).ToList();
                                                        var slotCompleted = slotAppointments.Any(a => string.Equals(a.Status?.Trim(), "Completed", StringComparison.OrdinalIgnoreCase));
                                                        var slotBooked = slotAppointments.Any(a => string.Equals(a.Status?.Trim(), "Scheduled", StringComparison.OrdinalIgnoreCase));
                                                        var localSlotDateTime = slotDateTime;
                                                        var slotExpired = !slotCompleted && !slotBooked && localSlotDateTime < now;
                                                 
                                                        var group = s.IsGroup && s.GroupId.HasValue ? groupAppointments.FirstOrDefault(g => g.GroupId == s.GroupId.Value) : null;
                                                        var enrolledCount = group?.StudentIds?.Count ?? 0;
                                                        var availableSeats = group == null ? 0 : Math.Max(0, group.Capacity - enrolledCount);
                                                        var isEnrolled = group?.StudentIds? .Contains(studentId) == true;

                                                        @if (s.IsGroup)
                                                        {
                                                            if (group != null)
                                                            {
                                                                var isFull = group.Status == "Full" || enrolledCount >= group.Capacity;
                                                                var isExpired = slotDateTime <= now;

                                                                if (isEnrolled || isFull || isExpired || isRescheduling)
                                                                {
                                                                    <div class="scheduler-slot scheduler-slot-group" >
                                                                        <span class="scheduler-slot-time"> @slotLabel </span>
                                                                        <span class="scheduler-slot-status"> @enrolledCount/@group.Capacity </span>
                                                                        <span class="scheduler-slot-status"> Group </span>

                                                                        @if (isEnrolled)
                                                                        {
                                                                            <span>Joined</span>
                                                                        }
                                                                        else if (isFull)
                                                                        {
                                                                            <span>Full</span>
                                                                        }
                                                                        else if (isExpired)
                                                                        {
                                                                            <span>Expired</span>
                                                                        }
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <form asp-controller="Appointment" asp-action="JoinGroupAppointment" method="post"
                                                                            onsubmit="return confirm('Do you want to join this group?');">

                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="groupId" value="@group.GroupId" />
                                                                        <button type="submit" class="scheduler-slot scheduler-slot-group">
                                                                            <span class="scheduler-slot-time"> @slotLabel </span>
                                                                            <span class="scheduler-slot-status"> @enrolledCount/@group.Capacity </span>
                                                                            <span class="scheduler-slot-status"> Group </span>
                                                                        </button>
                                                                    </form>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="scheduler-slot scheduler-slot-expired">
                                                                    <span class="scheduler-slot-time">
                                                                        @slotLabel
                                                                    </span>

                                                                    <span class="scheduler-slot-status">
                                                                        Unavailable
                                                                    </span>
                                                                </div>
                                                            }
                                                        }
                                                        else if (slotCompleted)
                                                        {
                                                            <div class="scheduler-slot scheduler-slot-completed">
                                                                <span class="scheduler-slot-time">@slotLabel</span>
                                                                <span class="scheduler-slot-status">Completed</span>
                                                            </div>
                                                        }
                                                        else if (slotBooked)
                                                        {
                                                            <div class="scheduler-slot scheduler-slot-booked">
                                                                <span class="scheduler-slot-time">@slotLabel</span>
                                                                <span class="scheduler-slot-status">Booked</span>
                                                            </div>
                                                        }
                                                        else if (slotExpired)
                                                        {
                                                            <div class="scheduler-slot scheduler-slot-expired">
                                                                <span class="scheduler-slot-time">@slotLabel</span>
                                                                <span class="scheduler-slot-status">Expired</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <form class="scheduler-booking-form" asp-controller="Appointment" asp-action="@(isRescheduling ? "RescheduleAppointment" : "BookAppointment")"
                                                                  method="post" onsubmit="return confirm('Do you want to confirm this appointment?');">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden" name="scheduleId" value="@s.ScheduleId" />
                                                                <input type="hidden" name="tutorId" value="@tutor.TutorId" />
                                                                <input type="hidden" name="studentId" value="@studentId" />
                                                                <input type="hidden" name="date" value="@s.Date.ToString("yyyy-MM-dd")" />
                                                                <input type="hidden" name="startTime" value="@s.StartTime.ToString(@"hh\:mm\:ss")" />

                                                                @if (isRescheduling)
                                                                {
                                                                    <input type="hidden" name="appointmentId" value="@rescheduleAppointmentId" />
                                                                }

                                                                <button type="submit" class="scheduler-slot scheduler-slot-available">
                                                                    <span class="scheduler-slot-time">@slotLabel</span>
                                                                    <span class="scheduler-slot-status">
                                                                        Book <span aria-hidden="true">→</span>
                                                                    </span>
                                                                </button>
                                                            </form>
                                                        }
                                                    }

                                                }
                                            </div>
                                        </div>
                                    </td>

                                    currentDay++;
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="scheduler-calendar-footer">
            <span>Viewing schedule for <strong>@tutor.FName @tutor.LName</strong></span>
            <span>All times are displayed in the system's configured appointment time basis.</span>
        </div>
    </section>
</div>