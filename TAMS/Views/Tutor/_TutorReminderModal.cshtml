@model TAMS.Models.Tutor

@using TAMS.Models

@{
    var reminderAppointments = ViewBag.TutorReminderAppointments as List<Appointment> ?? new List<Appointment>();
    var now = DateTime.Now;
}

<div id="tutorReminderModal" class="tutor-modal" role="dialog" aria-modal="true" aria-hidden="false" aria-labelledby="tutorReminderTitle">
    <div class="tutor-modal-content">
        <div class="tutor-modal-header">
            <h2 id="tutorReminderTitle">
                <i class="fas fa-bell" aria-hidden="true"></i>
                Reminders
            </h2>

            <button type="button" class="tutor-modal-close" aria-label="Close reminders" onclick="closeTutorModal('tutorReminderModal')">
                &times;
            </button>
        </div>

        <div class="tutor-modal-body">

            @{
                var hasCompletionReminders = reminderAppointments.Any(a => a.Status == "Scheduled" &&
                ((!a.TutorReminder1Acknowledged && now >= a.EndDate.AddHours(1)) ||
                (!a.TutorReminder2Acknowledged && now >= a.EndDate.AddHours(24)) ||
                (!a.TutorReminder3Acknowledged && now >= a.EndDate.AddHours(48))));

                var hasAppointmentReminders = reminderAppointments.Any(a => a.Status == "Scheduled" && ((a.Reminder24HoursBeforeSent &&
                !a.TutorAppointmentReminder24HoursAcknowledged) || (a.Reminder1HourBeforeSent &&
                !a.TutorAppointmentReminder1HourAcknowledged)));
            }

            @if (!hasCompletionReminders && !hasAppointmentReminders)
            {
                <div class="tutor-no-reminders">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    <p>You have no pending reminders.</p>
                </div>
            }
            else
            {
                <p class="tutor-reminder-intro">
                    Please review and confirm each reminder that needs your attention.
                </p>

                @foreach (var appointment in reminderAppointments.Where(a => a.Status == "Scheduled").OrderBy(a => a.AppointmentDate))
                {
                    var completionReminderTypes = new List<(int Hours, string Label)>();
                    if (!appointment.TutorReminder1Acknowledged && now >= appointment.EndDate.AddHours(1))
                    {
                        completionReminderTypes.Add((1, "1-hour completion reminder"));
                    }

                    if (!appointment.TutorReminder2Acknowledged && now >= appointment.EndDate.AddHours(24))
                    {
                        completionReminderTypes.Add((24, "24-hour completion reminder"));
                    }

                    if (!appointment.TutorReminder3Acknowledged && now >= appointment.EndDate.AddHours(48))
                    {
                        completionReminderTypes.Add((48, "48-hour completion reminder"));
                    }

                    var hasPendingAppointmentReminder = (appointment.Reminder24HoursBeforeSent &&
                    !appointment.TutorAppointmentReminder24HoursAcknowledged) || (appointment.Reminder1HourBeforeSent &&
                    !appointment.TutorAppointmentReminder1HourAcknowledged);

                    @if (completionReminderTypes.Any() || hasPendingAppointmentReminder)
                    {
                        <div class="tutor-reminder-card">
                            <div class="tutor-reminder-appointment">
                                <h3>
                                    Appointment
                                    <span>#@appointment.AppointmentId</span>
                                </h3>

                                <p>
                                    <strong>Appointment date:</strong>
                                    @appointment.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")
                                </p>

                                <p>
                                    <strong>End date:</strong>
                                    @appointment.EndDate.ToString("MMM dd, yyyy h:mm tt")
                                </p>

                                <p>
                                    <strong>Status:</strong>
                                    @appointment.Status
                                </p>
                            </div>

                            @* Upcoming appointment reminders *@

                            @if (appointment.Reminder24HoursBeforeSent && !appointment.TutorAppointmentReminder24HoursAcknowledged)
                            {
                                <div class="tutor-reminder-item">
                                    <div class="tutor-reminder-details">
                                        <i class="fas fa-clock" aria-hidden="true"></i>
                                        <span>24-hour appointment reminder</span>
                                    </div>

                                    <form asp-controller="Tutor" asp-action="ConfirmTutorReminder" method="post" class="tutor-reminder-confirm-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <input type="hidden" name="reminderType" value="24Hours" />
                                        <button type="submit" class="tutor-reminder-confirm-button">
                                            <i class="fas fa-check" aria-hidden="true"></i> Confirm
                                        </button>
                                    </form>
                                </div>
                            }

                            @if (appointment.Reminder1HourBeforeSent && !appointment.TutorAppointmentReminder1HourAcknowledged)
                            {
                                <div class="tutor-reminder-item">
                                    <div class="tutor-reminder-details">
                                        <i class="fas fa-clock" aria-hidden="true"></i>
                                        <span>1-hour appointment reminder</span>
                                    </div>

                                    <form asp-controller="Tutor" asp-action="ConfirmTutorReminder" method="post" class="tutor-reminder-confirm-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <input type="hidden" name="reminderType" value="1Hour" />
                                        <button type="submit" class="tutor-reminder-confirm-button">
                                            <i class="fas fa-check" aria-hidden="true"></i> Confirm
                                        </button>
                                    </form>

                                </div>
                            }

                            @* Completion reminders *@

                            @foreach (var reminder in completionReminderTypes)
                            {
                                <div class="tutor-reminder-item">
                                    <div class="tutor-reminder-details">
                                        <i class="fas fa-clock" aria-hidden="true"></i>
                                        <span>@reminder.Label</span>
                                    </div>

                                    <form asp-controller="Tutor" asp-action="ConfirmTutorReminder" method="post" class="tutor-reminder-confirm-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <input type="hidden" name="reminderHours" value="@reminder.Hours" />
                                        <button type="submit" class="tutor-reminder-confirm-button">
                                            <i class="fas fa-check" aria-hidden="true"></i>
                                            Confirm
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>

        <div class="tutor-modal-footer">
            <button type="button" class="tutor-reminder-close-button" onclick="closeTutorModal('tutorReminderModal')">
                Close
            </button>
        </div>
    </div>
</div>
