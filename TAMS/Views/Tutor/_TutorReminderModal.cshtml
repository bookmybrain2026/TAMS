@model TAMS.Models.Tutor

@using TAMS.Models

@{
    var reminderAppointments =
        ViewBag.TutorReminderAppointments as List<Appointment>
        ?? new List<Appointment>();

    var now = DateTime.Now;
}

<div id="tutorReminderModal" class="tutor-modal" role="dialog" aria-modal="true" aria-hidden="false" aria-labelledby="tutorReminderTitle">
    <div class="tutor-modal-content">
        <div class="tutor-modal-header">
            <h2 id="tutorReminderTitle">
                <i class="fas fa-bell" aria-hidden="true"></i>
                Completion Reminders
            </h2>

            <button type="button" class="tutor-modal-close" aria-label="Close reminders" onclick="closeTutorModal('tutorReminderModal')">
                &times;
            </button>
        </div>

        <div class="tutor-modal-body">
            @if (!reminderAppointments.Any(a => a.Status == "Scheduled" &&
                        ((!a.TutorReminder1Acknowledged && now >= a.EndDate.AddHours(1)) ||
                        (!a.TutorReminder2Acknowledged && now >= a.EndDate.AddHours(24)) ||
                        (!a.TutorReminder3Acknowledged && now >= a.EndDate.AddHours(48)))))
            {
                <div class="tutor-no-reminders">
                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                    <p>You have no pending completion reminders.</p>
                </div>
            }
            else
            {
                <p class="tutor-reminder-intro">
                    Please confirm each reminder after reviewing the appointment that needs your attention.
                </p>

                @foreach (var appointment in reminderAppointments)
                {
                    var reminderTypes = new List<(int Hours, string Label, bool IsDue)>();

                    if (!appointment.TutorReminder1Acknowledged &&
                    now >= appointment.EndDate.AddHours(1))
                    {
                        reminderTypes.Add((1, "1-hour completion reminder", true));
                    }

                    if (!appointment.TutorReminder2Acknowledged &&
                    now >= appointment.EndDate.AddHours(24))
                    {
                        reminderTypes.Add((24, "24-hour completion reminder", true));
                    }

                    if (!appointment.TutorReminder3Acknowledged &&
                    now >= appointment.EndDate.AddHours(48))
                    {
                        reminderTypes.Add((48, "48-hour completion reminder", true));
                    }

                    if (reminderTypes.Any())
                    {
                        <div class="tutor-reminder-card">
                            <div class="tutor-reminder-appointment">
                                <h3>
                                    Appointment
                                    <span>#@appointment.AppointmentId</span>
                                </h3>

                                <p>
                                    <strong>End date:</strong>
                                    @appointment.EndDate.ToString("MMM dd, yyyy h:mm tt")
                                </p>

                                <p>
                                    <strong>Status:</strong>
                                    @appointment.Status
                                </p>
                            </div>

                            @foreach (var reminder in reminderTypes)
                            {
                                <div class="tutor-reminder-item">
                                    <div class="tutor-reminder-details">
                                        <i class="fas fa-clock" aria-hidden="true"></i>
                                        <span>@reminder.Label</span>
                                    </div>

                                    <form asp-controller="Tutor" asp-action="ConfirmTutorReminder" method="post" class="tutor-reminder-confirm-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                        <input type="hidden" name="reminderHours" value="@reminder.Hours" />
                                        <button type="submit" class="tutor-reminder-confirm-button">
                                            <i class="fas fa-check" aria-hidden="true"></i>
                                            Confirm
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>

        <div class="tutor-modal-footer">
            <button type="button" class="tutor-reminder-close-button" onclick="closeTutorModal('tutorReminderModal')">
                Close
            </button>
        </div>
    </div>
</div>
