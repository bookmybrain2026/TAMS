@{
    var appointments = (List<TAMS.Models.Appointment>)ViewBag.Appointments;
    int month = ViewBag.Month;
    int year = ViewBag.Year;
    int tutorId = ViewBag.TutorId ?? 0;

    var firstDay = new DateTime(year, month, 1);
    int daysInMonth = DateTime.DaysInMonth(year, month);
    int startDayOfWeek = (int)firstDay.DayOfWeek;

    // Previous month
    int prevMonth = month - 1; int prevYear = year;
    if (prevMonth < 1) { prevMonth = 12; prevYear--; }

    // Next month
    int nextMonth = month + 1;
    int nextYear = year;
    if (nextMonth > 12) { nextMonth = 1; nextYear++; }
}

<link rel="stylesheet" href="~/css/TutorScheduleCalendar.css" asp-append-version="true" />
<body>
    <div class="schedule-calendar">

        @if (TempData["Error"] != null)
        {
            <div class="calendar-alert calendar-alert-error">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="calendar-alert calendar-alert-success">
                @TempData["Success"]
            </div>
        }

        <header class="calendar-header">
            <div class="calendar-heading">
                <span class="calendar-eyebrow">TAMS • TUTOR PORTAL</span>

                <h1>Tutor Appointments</h1>

                <p>View your scheduled appointments and student sessions.</p>
            </div>

            <a class="calendar-button calendar-button-primary"
               href="@Url.Action("Dashboard", "Tutor", new { id = tutorId })">
                ← Back to Dashboard
            </a>
        </header>

        <section class="calendar-card">

            <div class="calendar-toolbar">
                <a class="calendar-button calendar-button-secondary"
                   href="@Url.Action("ScheduleCalendar", "Tutor",  new { id = tutorId, month = prevMonth, year = prevYear })">
                    ← Previous Month
                </a>

                <div class="calendar-current-month">
                    <span class="calendar-month-label">CURRENT VIEW</span>
                    <h2>@firstDay.ToString("MMMM yyyy")</h2>
                </div>

                <a class="calendar-button calendar-button-secondary"
                   href="@Url.Action("ScheduleCalendar", "Tutor", new { id = tutorId, month = nextMonth, year = nextYear })">
                    Next Month →
                </a>
            </div>

            <div class="calendar-legend">
                <span class="legend-dot legend-dot-active"></span>
                <span>Scheduled appointment</span>

                <span class="legend-dot legend-dot-cancelled"></span>
                <span>Cancelled appointment</span>
            </div>

            <div class="calendar-table-wrapper">
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th>Sun</th>
                            <th>Mon</th>
                            <th>Tue</th>
                            <th>Wed</th>
                            <th>Thu</th>
                            <th>Fri</th>
                            <th>Sat</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int day = 1;
                            int totalCells = daysInMonth + startDayOfWeek;
                            int weeks = (int)Math.Ceiling(totalCells / 7.0);

                            for (int week = 0; week < weeks; week++)
                            {
                                <tr>
                                    @for (int dow = 0; dow < 7; dow++)
                                    {
                                        if ((week == 0 && dow < startDayOfWeek)
                                        || day > daysInMonth)
                                        {
                                            <td class="calendar-empty-cell"></td>
                                        }
                                        else
                                        {
                                            var currentDate = new DateTime(year, month, day);

                                            var dayAppointments = appointments
                                            .Where(a => a.AppointmentDate.Date == currentDate.Date)
                                            .OrderBy(a => a.AppointmentDate.TimeOfDay)
                                            .ToList();

                                            <td class="calendar-day-cell">
                                                <div class="calendar-day-number">
                                                    @day
                                                </div>

                                                <div class="calendar-day-name">
                                                    @currentDate.ToString("ddd")
                                                </div>

                                                <ul class="calendar-appointments">
                                                    @foreach (var appt in dayAppointments)
                                                    {
                                                        if (appt.Status == "Cancelled")
                                                        {
                                                            <li class="appointment-item appointment-cancelled">
                                                                <span class="appointment-time">
                                                                    @appt.AppointmentDate.AddHours(-5).ToString("hh:mm tt")
                                                                </span>

                                                                <span class="appointment-student">
                                                                    @appt.Student.FName @appt.Student.LName
                                                                </span>

                                                                <span class="appointment-status">
                                                                    Cancelled
                                                                </span>
                                                            </li>
                                                        }
                                                        else
                                                        {
                                                            <li class="appointment-item appointment-active">
                                                                <span class="appointment-time">
                                                                    @appt.AppointmentDate.AddHours(-5).ToString("hh:mm tt")
                                                                </span>

                                                                <span class="appointment-student">
                                                                    @appt.Student.FName @appt.Student.LName
                                                                </span>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </td>

                                            day++;
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer class="calendar-footer">
                Showing appointments for
                <strong>@firstDay.ToString("MMMM yyyy")</strong>
            </footer>

        </section>
    </div>
</body>