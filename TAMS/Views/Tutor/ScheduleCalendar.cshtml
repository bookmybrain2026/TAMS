@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="mb-3">
    <a class="btn btn-success"
       href="@Url.Action("Dashboard", "Tutor", new { id = tutorId })">
        ← Back to Dashboard
    </a>
</div>

<h1>
    Tutor Appointments -
    @firstDay.ToString("MMMM yyyy")
</h1>

<div class="d-flex justify-content-between mb-3">
    <a class="btn btn-secondary"
       href="@Url.Action("ScheduleCalendar", "Tutor", new {id = tutorId, month = prevMonth, year = prevYear })">
        ← Previous Month
    </a>

    <span class="align-self-center">@firstDay.ToString("MMMM yyyy")</span>

    <a class="btn btn-secondary"
       href="@Url.Action( "ScheduleCalendar", "Tutor", new {id = tutorId, month = nextMonth, year = nextYear })">
        Next Month →
    </a>
</div>

<table class="table table-bordered text-center">

    <thead>
        <tr>
            <th>Sun</th>
            <th>Mon</th>
            <th>Tue</th>
            <th>Wed</th>
            <th>Thu</th>
            <th>Fri</th>
            <th>Sat</th>
        </tr>
    </thead>

    <tbody>

        @{
            int day = 1;
            int totalCells = daysInMonth + startDayOfWeek;
            int weeks = (int)Math.Ceiling(totalCells / 7.0);

            for (int week = 0; week < weeks; week++)
            {
                <tr>
                    @for (int dow = 0; dow < 7; dow++)
                    {
                        if ((week == 0 && dow < startDayOfWeek) || day > daysInMonth)
                        {
                            <td></td>
                        }
                        else
                        {
                            var currentDate = new DateTime(year, month, day);

                            var dayAppointments = appointments
                                .Where(a => a.AppointmentDate.Date == currentDate.Date)
                                .OrderBy(a => a.AppointmentDate.TimeOfDay)
                                .ToList();
                            <td style="vertical-align: top; min-width: 120px;">
                                <strong>@day (@currentDate.ToString("ddd"))</strong>

                                <ul class="list-unstyled mt-1 mb-1">
                                    @foreach (var appt in dayAppointments)
                                    {
                                        if (appt.Status == "Cancelled")
                                        {
                                            <li class="text-muted"><s>@appt.AppointmentDate.AddHours(-5).ToString("hh:mm tt") - @appt.Student.FName @appt.Student.LName (Cancelled)</s></li>
                                        }
                                        else
                                        {
                                            <li>@appt.AppointmentDate.AddHours(-5).ToString("hh:mm tt") - @appt.Student.FName @appt.Student.LName</li>
                                        }
                                    }
                                </ul>
                            </td>
                            day++;
                        }
                    }
                </tr>
            }
        }
    </tbody>
</table>