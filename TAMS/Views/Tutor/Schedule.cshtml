@model List<TAMS.Models.Schedule>

@{
    int month = (ViewBag.Month is int m && m >= 1 && m <= 12) ? m : DateTime.Today.Month;
    int year = (ViewBag.Year is int y && y >= 1) ? y : DateTime.Today.Year;

    int tutorId = ViewBag.TutorId ?? 0;

    var firstDay = new DateTime(year, month, 1);
    int daysInMonth = DateTime.DaysInMonth(year, month);
    int startDayOfWeek = (int)firstDay.DayOfWeek;

    int prevMonth = month - 1;
    int prevYear = year;
    if (prevMonth < 1) { prevMonth = 12; prevYear--; }

    int nextMonth = month + 1;
    int nextYear = year;
    if (nextMonth > 12) { nextMonth = 1; nextYear++; }
}

@section Styles {
    <link href="~/css/AdminandTutorScheduler.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="schedule-page">
    @if (TempData["TutorScheduleError"] != null)
    {
        <div class="schedule-alert schedule-alert-error">@TempData["TutorScheduleError"]</div>
    }

    @if (TempData["TutorScheduleSuccess"] != null)
    {
        <div class="schedule-alert schedule-alert-success">@TempData["TutorScheduleSuccess"]</div>
    }

    <header class="schedule-header">
        <div class="schedule-heading">
            <span class="schedule-eyebrow">BMB • TUTOR PORTAL</span>
            <h1>Manage Schedule</h1>
            <p>Manage your availability and create group appointments.</p>
        </div>

        <div class="schedule-header-actions">

            <a asp-controller="Tutor" asp-action="CreateGroupAppointment" class="schedule-button schedule-button-group">
                <i class="fas fa-users"></i>
                Create Group Appointment
            </a>

            <a class="schedule-button schedule-button-primary" href="@Url.Action("Dashboard", "Tutor", new { id = tutorId })">
                &larr; Back to Dashboard
            </a>
        </div>
    </header>

    <section class="schedule-card">
        <div class="schedule-toolbar">
            <a class="schedule-button schedule-button-secondary" href="@Url.Action("Schedule", "Tutor", new { id = tutorId, month = prevMonth, year = prevYear })">
                &larr; Previous Month
            </a>

            <div class="schedule-current-month">
                <span class="schedule-month-label">SCHEDULE OVERVIEW</span>
                <h2>@firstDay.ToString("MMMM yyyy")</h2>
            </div>

            <a class="schedule-button schedule-button-secondary" href="@Url.Action("Schedule", "Tutor", new { id = tutorId, month = nextMonth, year = nextYear })">
                Next Month &rarr;
            </a>
        </div>

        <div class="schedule-legend">
            <span class="schedule-legend-dot"></span>
            <span>Available time slots</span>

            <span class="schedule-legend-dot schedule-legend-group"></span>
            <span>Group Appointments</span>
        </div>

        <div class="schedule-table-wrapper">
            <table class="schedule-table">
                <thead>
                    <tr>
                        <th>Sun</th>
                        <th>Mon</th>
                        <th>Tue</th>
                        <th>Wed</th>
                        <th>Thu</th>
                        <th>Fri</th>
                        <th>Sat</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int day = 1;
                        int totalCells = daysInMonth + startDayOfWeek;
                        int weeks = (int)Math.Ceiling(totalCells / 7.0);

                        for (int week = 0; week < weeks; week++)
                        {
                            <tr>
                                @for (int dow = 0; dow < 7; dow++)
                                {
                                    if ((week == 0 && dow < startDayOfWeek) || day > daysInMonth)
                                    {
                                        <td class="schedule-empty-cell"></td>
                                    }
                                    else
                                    {
                                        var currentDate = new DateTime(year, month, day);
                                        var daySchedules = Model .Where(s => s.Date.Date == currentDate.Date) .ToList();

                                        <td class="schedule-day-cell">
                                            <div class="schedule-day-heading">
                                                <span class="schedule-day-number"> @day </span>
                                                <span class="schedule-day-name"> @currentDate.ToString("ddd") </span>
                                            </div>

                                            <div class="schedule-slots">
                                                @if (daySchedules.Any())
                                                {

                                                    @foreach (var s in daySchedules.OrderBy(s => s.StartTime))
                                                    {

                                                        <div class="schedule-slot @(s.IsGroup ? "schedule-slot-group" : "")">
                                                            <span class="schedule-slot-dot"></span>
                                                            <span>
                                                                @DateTime.Today.Add(s.StartTime).ToString("h:mm tt")
                                                                -
                                                                @DateTime.Today.Add(s.EndTime).ToString("h:mm tt")
                                                            </span>
                                                        </div>

                                                    }

                                                }
                                                else
                                                {
                                                    <p class="schedule-no-slots">
                                                        No availability
                                                    </p>
                                                }
                                            </div>


                                            @if (currentDate.Date < DateTime.Today)
                                            {
                                                <p class="schedule-no-slots">
                                                    Past date — schedules cannot be added.
                                                </p>
                                            }
                                            else
                                            {
                                                <form asp-controller="Tutor" asp-action="AddSchedule" method="post" class="schedule-add-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tutorId" value="@tutorId" />
                                                    <input type="hidden" name="date" value="@currentDate.ToString("yyyy-MM-dd")" />
                                                    <label class="schedule-input-label">Start time</label>
                                                    <input type="time" name="startTime" class="schedule-time-input" min="@(currentDate.Date == DateTime.Today ? DateTime.Now.ToString("HH:mm") : null)" required />
                                                    <label class="schedule-input-label">End time</label>
                                                    <input type="time" name="endTime" class="schedule-time-input" required />
                                                    <button type="submit" class="schedule-add-button"> &#43; Add Schedule </button>
                                                </form>
                                            }

                                        </td>

                                        day++;
                                    }
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="schedule-footer">
            Managing availability for <strong>@firstDay.ToString("MMMM yyyy")</strong>
        </footer>
    </section>

</div>