@model IEnumerable<TAMS.Models.Tutor>

@{
    ViewData["Title"] = "Tutors";
}
<head>
    <link href="~/css/ourtutors.css" rel="stylesheet" />
</head>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Our Tutors</h1>
        <p class="text-muted">
            Browse our tutors and find someone who can help you with your courses.
        </p>
    </div>

    <div class="mb-4">
        <input type="text" id="tutorSearch" class="form-control" placeholder="Search tutors..." onkeyup="searchTutors()" />
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            There are currently no tutors available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var tutor in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm tutor-card">
                        <div class="card-body">
                            <h4 class="card-title"> @tutor.FName @tutor.LName </h4>
                            <hr />
                            <p class="mb-2"> <strong>Email:</strong> @tutor.Email </p>
                            <p class="mb-2"> <strong>Phone:</strong> @tutor.PhoneNumber </p>
                            <p class="mb-3"> <strong>Subject:</strong> @tutor.Subject </p>
                            <p class="mb-3">
                                <strong>Rating:</strong>

                                @if (tutor.ReviewCount > 0)
                                {
                                    <span>@tutor.AverageRating.ToString("0.0") / 5</span>
                                    <span class="text-muted">
                                        (@tutor.ReviewCount
                                        @(tutor.ReviewCount == 1 ? "review" : "reviews"))
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No ratings yet</span>
                                }
                            </p>
                            <a asp-controller="Tutor" asp-action="Details" asp-route-id="@tutor.TutorId" class="btn btn-primary w-100">View Tutor Profile</a>
                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>