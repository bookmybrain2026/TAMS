@model TAMS.Models.Tutor

@{
    ViewData["Title"] = "Tutor Dashboard";

    var appointments = ViewBag.Appointments as List<TAMS.Models.Appointment> ?? new List<TAMS.Models.Appointment>();
    var schedules = ViewBag.Schedules as List<TAMS.Models.Schedule> ?? new List<TAMS.Models.Schedule>();
    var upcomingAppointments = 
        appointments.Where(a => a.AppointmentDate >= DateTime.Now && a.Status == "Scheduled")
        .OrderBy(a => a.AppointmentDate).ToList();
}

<div class="container mt-5">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1>Tutor Dashboard</h1>
            <p class="text-muted">
                Welcome back, @Model.FName @Model.LName!
            </p>
        </div>
    </div>

    <hr />

    <!-- Tutor Information -->
    <div class="row mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4>
                        @Model.FName @Model.LName
                    </h4>

                    <p>
                        <strong>Email:</strong>@Model.Email
                    </p>

                    <p>
                        <strong>Phone:</strong>@Model.PhoneNumber
                    </p>

                    <p>
                        <strong>Subject:</strong>@Model.Subject
                    </p>

                    <a asp-controller="Tutor" asp-action="Profile" class="btn btn-primary">
                        View / Edit Profile
                    </a>

                    <a asp-controller="Tutor" asp-action="Schedule" asp-route-id="@Model.TutorId" class="btn btn-secondary">
                        Manage Schedule
                    </a>
                    <a asp-controller="Tutor" asp-action="ScheduleCalendar" asp-route-id="@Model.TutorId" class="btn btn-info">
                        View Appointments
                    </a>
                </div>
            </div>
        </div>

        <!-- Appointment Summary -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4>Appointment Summary</h4>

                    <p>
                        <strong>Upcoming Appointments:</strong>
                        @upcomingAppointments.Count
                    </p>

                    <p>
                        <strong>Total Appointments:</strong>
                        @appointments.Count
                    </p>

                    <p>
                        <strong>Available Schedule Entries:</strong>
                        @schedules.Count
                    </p>

                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming Appointments -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h3 class="mb-3">
                Upcoming Appointments
            </h3>

            @if (upcomingAppointments.Count == 0)
            {
                <div class="alert alert-info">
                    You currently have no upcoming appointments.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var appointment in upcomingAppointments)
                            {
                                <tr>

                                    <td>
                                        @appointment.AppointmentDate.ToString("MM/dd/yyyy")
                                    </td>

                                    <td>
                                        @appointment.AppointmentDate.ToString("hh:mm tt")
                                    </td>

                                    <td>
                                        @if (appointment.Student != null)
                                        {
                                            @($"{appointment.Student.FName} {appointment.Student.LName}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Student not found</span>
                                        }
                                    </td>

                                    <td>
                                        @if (appointment.Student != null)
                                        {
                                            @appointment.Student.Email
                                        }
                                    </td>

                                    <td>
                                        @if (appointment.Student != null)
                                        {
                                            @appointment.Student.PhoneNumber
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @appointment.Status
                                        </span>
                                    </td>

                                    <td>

                                        <form asp-controller="Tutor"
                                              asp-action="CompleteAppointment"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="appointmentId"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Mark this appointment as completed?');">
                                                Complete
                                            </button>
                                        </form>

                                        <form asp-controller="Tutor"
                                              asp-action="CancelAppointment"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="appointmentId"
                                                   value="@appointment.AppointmentId" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Cancel this appointment?');">
                                                Cancel
                                            </button>
                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- All Appointments -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h3 class="mb-3">
                Appointment History
            </h3>

            @if (appointments.Count == 0)
            {
                <div class="alert alert-info">
                    No appointments have been scheduled yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Student</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var appointment in appointments.OrderByDescending(a => a.AppointmentDate))
                            {
                                <tr>

                                    <td>
                                        @appointment.AppointmentDate.ToString("MM/dd/yyyy")
                                    </td>

                                    <td>
                                        @appointment.AppointmentDate.AddHours(-5).ToString("hh:mm tt")
                                    </td> //hhbhb

                                    <td>
                                        @if (appointment.Student != null)
                                        {
                                            @($"{appointment.Student.FName} {appointment.Student.LName}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Student not found
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (appointment.Status == "Scheduled")
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }
                                        else if (appointment.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (appointment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @appointment.Status
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
<hr />

<h2>Your Schedule</h2>

@if (Model.Schedules == null || !Model.Schedules.Any())
{
    <p>No schedule slots added yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Schedules.OrderBy(s => s.Date).ThenBy(s => s.StartTime))
            {
                <tr>
                    <td>@s.Date.ToString("MM/dd/yyyy")</td>
                    <td>@s.StartTime.ToString(@"hh\:mm")</td>
                    <td>@s.EndTime.ToString(@"hh\:mm")</td>
                    <td>
                        <form asp-action="DeleteSchedule" method="post" onsubmit="return confirm('Are you sure you want to delete this slot?');">
                            <input type="hidden" name="scheduleId" value="@s.ScheduleId" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<h2>Patient Reviews</h2>

<div class="patient-reviews-card">

    <div class="rating-summary">
        <span class="average-rating">
            ★ @Model.AverageRating.ToString("0.0") / 5
        </span>

        <span class="review-count">
            @Model.ReviewCount patient reviews
        </span>
    </div>

    <div class="patient-reviews-list">

        @if (Model.Reviews == null || !Model.Reviews.Any())
        {
            <p class="text-muted">No patient reviews yet.</p>
        }
        else
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="patient-review">

                    <div class="review-rating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span class="star-filled">★</span>
                            }
                            else
                            {
                                <span class="star-empty">★</span>
                            }
                        }
                    </div>

                    <p class="review-comment">
                        @review.Comment
                    </p>

                </div>
            }
        }

    </div>

</div>