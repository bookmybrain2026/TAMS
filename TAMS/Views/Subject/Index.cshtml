@model IEnumerable<TAMS.Models.Subject>

@{
    ViewData["Title"] = "Manage Subjects";
    var subjects = Model?.ToList() ?? new List<TAMS.Models.Subject>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/SubjectIndex.css" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="subject-dashboard">
    <header class="dashboard-header">
        <div>
            <p class="dashboard-eyebrow">BMB · ADMINISTRATION</p>
            <h1>Subject Management</h1>
            <p class="dashboard-subtitle"> Create, update, and organize the subjects available for tutoring. </p>
        </div>

        <div class="header-actions">
            <a asp-controller="Admin" asp-action="Dashboard" class="subject-secondary-button"> &larr; Back to Dashboard </a>
            <button type="button" class="subject-primary-button" onclick="showSubjectAddForm()">
                <span aria-hidden="true">&#43;</span> Add New Subject
            </button>
        </div>
    </header>

    <section class="subject-summary" aria-label="Subject overview">
        <article class="subject-summary-card summary-card-cream">
            <div class="summary-card-top">
                <span class="summary-label">Total Subjects</span>
                <span class="summary-icon" aria-hidden="true">▤</span>
            </div>

            <div class="summary-number" id="subjectCount"> @subjects.Count </div>
            <p class="summary-note">Subjects currently in the system</p>
            <div class="summary-bottom-line">
                <span style="width:100%"></span>
            </div>
        </article>
    </section>

    <section class="dashboard-section">
        <div class="section-heading">
            <div>
                <p class="section-kicker">SUBJECT DIRECTORY</p>
                <h2>All Subjects</h2>
            </div>
            <span class="count-pill"> @subjects.Count subjects </span>
        </div>
        @if (TempData["SubjectSuccess"] != null)
        {
            <div class="subject-alert alert-success" role="status"> @TempData["SubjectSuccess"] </div>
        }
        @if (TempData["SubjectError"] != null)
        {
            <div class="subject-alert alert-error" role="alert"> @TempData["SubjectError"] </div>
        }

        <div class="directory-search">
            <span class="directory-search-icon" aria-hidden="true">⌕</span>
            <input type="text" id="subjectSearch" class="subject-input directory-search-input" placeholder="Search by subject code or subject name..."
                   aria-label="Search subjects" autocomplete="off" oninput="searchSubjects()" />
        </div>

        <div class="subject-table-wrap">
            <table class="subject-table" id="subjectTable">
                <thead>
                    <tr>
                        <th>Subject Code</th>
                        <th>Subject Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="subjectTableBody">
                    @if (subjects.Count > 0)
                    {
                        @foreach (var subject in subjects)
                        {
                            <tr class="subject-row"
                                data-search="@($"{subject.Code} {subject.Name}")">

                                <td>
                                    <span class="subject-pill"> @subject.Code </span>
                                </td>
                                <td>@subject.Name</td>
                                <td>
                                    <div class="table-actions">
                                        <button type="button" class="small-action action-edit" onclick="showSubjectEditForm('@subject.SubjectId', '@subject.Code', '@subject.Name')">
                                            Edit
                                        </button>

                                        <form asp-controller="Subject" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this subject?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@subject.SubjectId" />
                                            <button type="submit" class="small-action action-delete">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="subjectNoMatch" style="display:none;">
                            <td colspan="3" class="empty-state"> No subjects match your search. </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="empty-state"> No subjects found. Add a subject to get started. </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div id="addSubjectModal" class="subject-modal" style="display:none;" aria-hidden="true">
        <div class="subject-modal-content" role="dialog" aria-modal="true" aria-labelledby="addSubjectTitle">
            <button type="button" class="subject-modal-close" onclick="hideSubjectForms()" aria-label="Close">
                &times;
            </button>

            <p class="section-kicker">SUBJECT DIRECTORY</p>
            <h2 id="addSubjectTitle">Add New Subject</h2>
            <p class="modal-subtitle"> Enter the details for the new tutoring subject. </p>

            <form asp-controller="Subject" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="subject-form-group">
                    <label for="CreateCode">Subject Code</label>
                    <input type="text" id="CreateCode" name="Code" class="subject-input" placeholder="Example: MATH" required />
                </div>

                <div class="subject-form-group">
                    <label for="CreateName">Subject Name</label>
                    <input type="text" id="CreateName" name="Name" class="subject-input" placeholder="Example: Mathematics" required />
                </div>

                <div class="form-actions">
                    <button type="submit" class="subject-primary-button"> Create Subject </button>
                    <button type="button" class="subject-secondary-button" onclick="hideSubjectForms()"> Cancel </button>
                </div>
            </form>
        </div>
    </div>

    <div id="editSubjectModal" class="subject-modal" style="display:none;" aria-hidden="true">
        <div class="subject-modal-content" role="dialog" aria-modal="true" aria-labelledby="editSubjectTitle">
            <button type="button" class="subject-modal-close" onclick="hideSubjectForms()" aria-label="Close">
                &times;
            </button>

            <p class="section-kicker">SUBJECT DIRECTORY</p>
            <h2 id="editSubjectTitle">Edit Subject</h2>
            <p class="modal-subtitle">Update the selected subject information.</p>

            <form asp-controller="Subject" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" id="EditSubjectId" name="id" />

                <div class="subject-form-group">
                    <label for="EditCode">Subject Code</label>
                    <input type="text" id="EditCode" name="Code" class="subject-input" required />
                </div>

                <div class="subject-form-group">
                    <label for="EditName">Subject Name</label>
                    <input type="text" id="EditName" name="Name" class="subject-input" required />
                </div>

                <div class="form-actions">
                    <button type="submit" class="subject-primary-button"> Save Changes </button>
                    <button type="button" class="subject-secondary-button" onclick="hideSubjectForms()"> Cancel </button>
                </div>
            </form>
        </div>
    </div>

    <footer class="dashboard-footer">
        BMB · Book My Brain
    </footer>

</div>
