@model IEnumerable<TAMS.Models.Subject>

@{
    ViewData["Title"] = "Manage Subjects";
}

<a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary mb-3">← Back to Dashboard</a>

<h1>Manage Subjects</h1>

<div class="mb-3">
    <label for="subjectSearch" class="form-label">Search Subjects</label>
    <input type="text" id="subjectSearch" class="form-control" placeholder="Search by subject code or subject name..." onkeyup="searchSubjects()" />
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered" id="subjectTable">

    <thead>
        <tr>
            <th>Subject Code</th>
            <th>Subject Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="subjectTableBody">

        @foreach (var subject in Model)
        {
            <tr>
                <td>@subject.Code</td>
                <td>@subject.Name</td>
                <td>
                    <!-- Edit Button -->
                    <button type="button" class="btn btn-warning" onclick="showSubjectEditForm( '@subject.SubjectId', '@subject.Code', '@subject.Name')">Edit</button>
                    <!-- Delete Button -->
                    <form asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this subject?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@subject.SubjectId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<button type="button" class="btn btn-primary" onclick="showSubjectAddForm()"> Add New Subject </button>

<!--Create Subject-->
<div id="addForm" style="display:none; margin-top:20px;">
    <h3>Add New Subject</h3>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group mb-3">
            <label for="CreateCode"> Subject Code </label>
            <input type="text" id="CreateCode" name="Code" class="form-control" placeholder="Example: MATH" required />
        </div>

        <div class="form-group mb-3">
            <label for="CreateName"> Subject Name </label>
            <input type="text" id="CreateName" name="Name" class="form-control" placeholder="Example: Mathematics" required />
        </div>
        <button type="submit" class="btn btn-primary"> Create Subject </button>
        <button type="button" class="btn btn-secondary" onclick="hideSubjectForms()"> Cancel </button>
    </form>
</div>

<!--Edit Subject -->

<div id="editForm" style="display:none; margin-top:20px;">
    <h3>Edit Subject</h3>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="EditSubjectId" name="id" />
        <div class="form-group mb-3">
            <label for="EditCode">Subject Code</label>
            <input type="text" id="EditCode" name="Code" class="form-control" required />
        </div>

        <div class="form-group mb-3">
            <label for="EditName">Subject Name </label>
            <input type="text" id="EditName" name="Name" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <button type="button" class="btn btn-secondary" onclick="hideSubjectForms()"> Cancel </button>
    </form>
</div>