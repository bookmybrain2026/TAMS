@using TAMS.Models

<div class="d-flex justify-content-end">
    <form asp-controller="Login" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-danger">
            Logout
        </button>
    </form>
</div>

@{
    var tutor = (TAMS.Models.Tutor)ViewBag.Tutor;
    var appointments = (List<TAMS.Models.Appointment>)ViewBag.Appointments;
    var schedules = (List<TAMS.Models.Schedule>)ViewBag.Schedules;

    int studentId = ViewBag.StudentId;
    int month = ViewBag.Month;
    int year = ViewBag.Year;

    var now = DateTime.Now;

    var firstDay = new DateTime(year, month, 1);
    int daysInMonth = DateTime.DaysInMonth(year, month);
}

<h1>
    Appointment Scheduler -
    @tutor.FName @tutor.LName
</h1>

<a class="btn btn-primary mb-3"
   href="@Url.Action("Dashboard", "Student", new { id = studentId })">
    ← Back to Dashboard
</a>

<h3>@firstDay.ToString("MMMM yyyy")</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<!-- Month Navigation -->
<div class="d-flex justify-content-between mb-3">

    <a class="btn btn-secondary"
       href="@Url.Action("Scheduler", "Appointment", new {
           tutorId = tutor.TutorId,
           studentId = studentId,
           month = month - 1,
           year = year
       })">
        ← Previous Month
    </a>

    <a class="btn btn-secondary"
       href="@Url.Action("Scheduler", "Appointment", new {
           tutorId = tutor.TutorId,
           studentId = studentId,
           month = month + 1,
           year = year
       })">
        Next Month →
    </a>

</div>

<table class="table table-bordered text-center">

    <thead>
        <tr>
            @foreach (var weekday in new[]
            {
                "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
            })
            {
                <th>@weekday</th>
            }
        </tr>
    </thead>

    <tbody>

        @{
            int currentDay = 1;
            int startDayOfWeek = (int)firstDay.DayOfWeek;
        }

        @while (currentDay <= daysInMonth)
        {
            <tr>

                @for (int dow = 0; dow < 7; dow++)
                {
                    if ((currentDay == 1 && dow < startDayOfWeek) ||
                        currentDay > daysInMonth)
                    {
                        <td></td>
                    }
                    else
                    {
                        var selectedDay = currentDay;

                        var selectedDate =
                            firstDay.AddDays(selectedDay - 1);

                        var daySchedules = schedules
                            .Where(s => s.Date.Date == selectedDate.Date)
                            .OrderBy(s => s.StartTime)
                            .ToList();

                        var dayAppointments = appointments
                            .Where(a =>
                                a.AppointmentDate.AddHours(-5).Date ==
                                selectedDate.Date &&
                                (a.Status == "Scheduled" ||
                                 a.Status == "Completed"))
                            .OrderBy(a => a.AppointmentDate.TimeOfDay)
                            .ToList();

                        <td style="vertical-align: top; min-width: 130px;">

                            <strong>
                                @selectedDay
                                (@selectedDate.ToString("ddd"))
                            </strong>

                            <div>

                                <em>Available Slots:</em>

                                <ul class="mb-1"
                                    style="list-style: none; padding-left: 0;">

                                    @foreach (var s in daySchedules)
                                    {
                                        // The schedule date and time represent
                                        // the local time displayed to the student.
                                        var slotDateTime =
                                            s.Date.Date.Add(s.StartTime);

                                        // Check whether a Completed appointment
                                        // occupies this schedule slot.
                                        var slotCompleted =
                                            dayAppointments.Any(a =>
                                            {
                                                var localAppointmentTime =
                                                    a.AppointmentDate.AddHours(-5);

                                                return
                                                    a.Status == "Completed" &&
                                                    localAppointmentTime.Date ==
                                                        slotDateTime.Date &&
                                                    localAppointmentTime.TimeOfDay >=
                                                        s.StartTime &&
                                                    localAppointmentTime.TimeOfDay <
                                                        s.EndTime;
                                            });

                                        // Check whether a Scheduled appointment
                                        // occupies this schedule slot.
                                        var slotBooked =
                                            dayAppointments.Any(a =>
                                            {
                                                var localAppointmentTime =
                                                    a.AppointmentDate.AddHours(-5);

                                                return
                                                    a.Status == "Scheduled" &&
                                                    localAppointmentTime.Date ==
                                                        slotDateTime.Date &&
                                                    localAppointmentTime.TimeOfDay >=
                                                        s.StartTime &&
                                                    localAppointmentTime.TimeOfDay <
                                                        s.EndTime;
                                            });

                                        // A completed appointment is not expired.
                                        // Both completed and scheduled appointments
                                        // are displayed to the student as Booked.
                                        var slotExpired =
                                            !slotCompleted &&
                                            !slotBooked &&
                                            slotDateTime < now;

                                        if (slotCompleted)
                                        {
                                            <li class="text-muted">

                                                <s>
                                                    @s.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @s.EndTime.ToString(@"hh\:mm")
                                                    (Booked)
                                                </s>

                                            </li>
                                        }
                                        else if (slotBooked)
                                        {
                                            <li class="text-muted">

                                                <s>
                                                    @s.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @s.EndTime.ToString(@"hh\:mm")
                                                    (Booked)
                                                </s>

                                            </li>
                                        }
                                        else if (slotExpired)
                                        {
                                            <li class="text-muted">

                                                <s>
                                                    @s.StartTime.ToString(@"hh\:mm")
                                                    -
                                                    @s.EndTime.ToString(@"hh\:mm")
                                                    (Expired)
                                                </s>

                                            </li>
                                        }
                                        else
                                        {
                                            <li>

                                                <form asp-controller="Appointment"
                                                      asp-action="BookAppointment"
                                                      method="post"
                                                      onsubmit="return confirm('Do you want to confirm this appointment?');">

                                                    <input type="hidden"
                                                           name="tutorId"
                                                           value="@tutor.TutorId" />

                                                    <input type="hidden"
                                                           name="appointmentDate"
                                                           value="@slotDateTime.ToString("yyyy-MM-ddTHH:mm")" />

                                                    <input type="hidden"
                                                           name="studentId"
                                                           value="@studentId" />

                                                    <button type="submit"
                                                            class="btn btn-link p-0 m-0">

                                                        @s.StartTime.ToString(@"hh\:mm")
                                                        -
                                                        @s.EndTime.ToString(@"hh\:mm")

                                                    </button>

                                                </form>

                                            </li>
                                        }
                                    }

                                </ul>

                            </div>

                        </td>

                        currentDay++;
                    }
                }

            </tr>
        }

    </tbody>

</table>