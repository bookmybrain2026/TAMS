@model TAMS.Models.Tutor

@using TAMS.Models
@using System.Linq

<div class="d-flex justify-content-end">

    <form asp-controller="Login" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Logout</button>
    </form>
</div>

<h1>Tutor Profile</h1>

<hr />

<div class="card">
    <div class="card-body">
        <h2>
            @Model.FName @Model.LName
        </h2>
        <p>
            <strong>Average Rating:</strong>
            @if (Model.ReviewCount > 0)
            {
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(Model.AverageRating))
                    {
                        <span>⭐</span>
                    }
                    else
                    {
                        <span>☆</span>
                    }
                }
                <strong>@Model.AverageRating.ToString("0.0")/5</strong>
                <span class="text-muted">
                    (@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews"))
                </span>
            }
            else
            {
                <span class="text-muted">No ratings yet</span>
            }
        </p>
        <p>
            <strong>Subject:</strong> @Model.Subject
        </p>

        <p>
            <strong>Email:</strong> @Model.Email
        </p>

        <p>
            <strong>Phone:</strong> @Model.PhoneNumber
        </p>

        <hr />

        <h4>Courses Tutored</h4>

        @{
            var courses = ViewBag.Courses as List<Course>
            ?? new List<Course>();
        }

        @if (courses.Any())
        {
            <ul>
                @foreach (var course in courses)
                {
                    <li>
                        @course.CourseCode

                        @if (!string.IsNullOrWhiteSpace(course.CourseName))
                        {
                            @: - @course.CourseName
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">
                No courses listed for this tutor.
            </p>
        }

        <hr />

        <a class="btn btn-secondary"
           href="@Url.Action("Dashboard","Student", new { id = ViewBag.StudentId })">
            ← Back to Dashboard
        </a>

        <a class="btn btn-success"
           href="@Url.Action("Scheduler","Appointment", new { tutorId = Model.TutorId })">
            View Schedule
        </a>
    </div>
</div>

<h4>Student Reviews</h4>
@if (Model.Reviews != null && Model.Reviews.Any())
{
    foreach (var review in Model.Reviews)
    {
        <div class="card mb-3">
            <div class="card-body">
                @* <h5>
                    @review.StudentName
                </h5> *@
                <p>
                    <strong>Rating:</strong>
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= review.Rating)
                        {
                            <span>⭐</span>
                        }
                        else
                        {
                            <span>☆</span>
                        }
                    }

                    <span>
                        (@review.Rating/5)
                    </span>
                </p>

                <p>
                    @review.Comment
                </p>

                <small class="text-muted">
                    Submitted on @review.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy")
                </small>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        No reviews have been submitted for this tutor yet.
    </div>
}