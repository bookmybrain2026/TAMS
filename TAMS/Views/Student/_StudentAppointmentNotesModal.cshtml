@model TAMS.Models.Appointment

@{
    var tutorName = Model.Tutor == null ? "Your tutor" : $"{Model.Tutor.FName} {Model.Tutor.LName}";
}

<div id="studentAppointmentNotesModal" class="tutor-modal student-reminder-modal" role="dialog"
     aria-modal="true" aria-labelledby="studentAppointmentNotesTitle" aria-hidden="false">

    <div class="tutor-modal-content">
        <div class="tutor-modal-header">
            <h2 id="studentAppointmentNotesTitle">
                Appointment Notes
            </h2>

            <button type="button" class="tutor-modal-close" aria-label="Close notes"
                    onclick="closeTutorModal('studentAppointmentNotesModal')">
                &times;
            </button>
        </div>

        <div class="tutor-modal-body">
            <div class="tutor-reminder-card">
                <h3>@tutorName</h3>

                <p>
                    <strong>Appointment:</strong>
                    @Model.AppointmentDate.ToString("MMMM d, yyyy 'at' h:mm tt")
                </p>

                <div class="tutor-reminder-item">
                    <div>
                        <strong>Tutor Notes</strong>

                        @if (!string.IsNullOrWhiteSpace(Model.TutorNotes))
                        {
                            <p>@Model.TutorNotes</p>
                        }
                        else
                        {
                            <p>No notes have been added for this appointment.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="tutor-modal-footer">
            <button type="button" class="tutor-reminder-close-button"
                    onclick="closeTutorModal('studentAppointmentNotesModal')">
                Close
            </button>
        </div>
    </div>
</div>
