<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TAMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/TAMS.styles.css" asp-append-version="true" /> *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm tams-navbar">
            <div class="container-fluid tams-navbar-container">
                <a class="navbar-brand tams-brand" asp-area="" asp-controller="Home" asp-action="Welcome">
                    <span class="brand-icon">B</span>
                    <span class="brand-text">BookMy<span>Brain</span></span>
                </a>

                <button class="navbar-toggler tams-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto tams-nav-links">

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Welcome">Home</a>
                            @* <img src="~/images/BMB Owl.png" alt="BookMyBrain" class="navbar-logo" /> *@
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tutor" asp-action="OurTutors">Tutor Profiles</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Appointment" asp-action="Groups">Groups</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Login" asp-action="Login">Login</a>
                        </li>

                    </ul>

                    @if (Context.Session.GetInt32("StudentId") != null || Context.Session.GetInt32("TutorId") != null || Context.Session.GetInt32("AdminId") != null)
                    {
                        <form asp-controller="Login" asp-action="Logout" method="post" class="tams-logout-form">
                            <button type="submit" class="tams-logout-btn">
                                <span>Logout</span>
                                <span aria-hidden="true">&rarr;</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TAMS - <a> asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>        
    <script>
        window.addEventListener("pagehide", function () {
            document.documentElement.style.visibility = "hidden";
        });
    
        window.addEventListener("pageshow", function (event) {
            if (event.persisted) {
                window.location.replace("/Login/Login");
            } else {
                document.documentElement.style.visibility = "visible";
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
